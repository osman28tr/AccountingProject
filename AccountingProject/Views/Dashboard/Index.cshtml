@model AccountingProject.Models.DashboardViewModel
@using System.Globalization
@{
    Layout = null;
    var tr = new CultureInfo("tr-TR");
    var month = Model.Month;
    string Money(decimal v) => v.ToString("C0", tr);
    string Num(decimal v) => v.ToString("0.##", CultureInfo.InvariantCulture);   // number input için
    string Bar(int p) => p > 100 ? "danger" : p > 80 ? "warning" : "success";
    string Delta(decimal? d) => d is null ? "Geçen ay kayıt yok"
        : (d >= 0 ? "▲ %" : "▼ %") + Math.Abs(d.Value).ToString("0", tr) + " geçen aya göre";

    var savings = Model.TotalIncome > 0 ? "%" + Math.Round(Model.Net / Model.TotalIncome * 100).ToString("0", tr) : "-";
    var boxes = new[]
    {
        ("success", "arrow-down-circle-fill", "Aylık gelir", Money(Model.TotalIncome), Delta(Model.IncomeChange)),
        ("danger", "arrow-up-circle-fill", "Aylık gider", Money(Model.TotalExpense), Delta(Model.ExpenseChange)),
        (Model.Net < 0 ? "danger" : "primary", "wallet-fill", "Kalan (net)", Money(Model.Net), "Gelir - gider"),
        ("warning", "piggy-bank-fill", "Tasarruf oranı", savings, "Gelirin ne kadarı kaldı")
    };
}
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Muhasebe | Genel Bakış</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        document.documentElement.dataset.bsTheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fontsource/source-sans-3@5.0.12/index.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4/dist/css/adminlte.min.css" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">

        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <ul class="navbar-nav"><li class="nav-item"><a class="nav-link" data-lte-toggle="sidebar" href="#" aria-label="Menü"><i class="bi bi-list"></i></a></li></ul>
            </div>
        </nav>

        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
            <div class="sidebar-brand"><a asp-action="Index" class="brand-link"><i class="bi bi-wallet2 brand-image fs-4 text-white"></i><span class="brand-text fw-light">Muhasebe</span></a></div>
            <div class="sidebar-wrapper">
                <ul class="nav sidebar-menu flex-column mt-2">
                    <li class="nav-item"><a href="#" class="nav-link active"><i class="nav-icon bi bi-speedometer"></i><p>Genel bakış</p></a></li>
                    <li class="nav-item"><a href="#kurum" class="nav-link"><i class="nav-icon bi bi-bank2"></i><p>Kurum durumu</p></a></li>
                    <li class="nav-item"><a href="#yonetim" class="nav-link"><i class="nav-icon bi bi-sliders"></i><p>Sabit gider ve borçlar</p></a></li>
                    <li class="nav-item"><a href="#islemler" class="nav-link"><i class="nav-icon bi bi-list-ul"></i><p>İşlemler</p></a></li>
                </ul>
            </div>
        </aside>

        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <div class="row align-items-center g-2">
                        <div class="col-sm-6"><h1 class="mb-0 fs-3">Genel bakış</h1></div>
                        <div class="col-sm-6 d-flex justify-content-sm-end gap-2">
                            <form asp-action="Index" method="get">
                                <input type="hidden" name="filter" value="@Model.Filter" />
                                <input type="month" name="month" value="@month" class="form-control" aria-label="Ay" onchange="this.form.submit()" />
                            </form>
                            <button class="btn btn-success" data-income="true" data-bs-toggle="modal" data-bs-target="#txModal"><i class="bi bi-plus-lg"></i> Gelir</button>
                            <button class="btn btn-danger" data-income="false" data-bs-toggle="modal" data-bs-target="#txModal"><i class="bi bi-plus-lg"></i> Gider</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="app-content">
                <div class="container-fluid">

                    @foreach (var (key, css) in new[] { ("Success", "success"), ("Error", "danger") })
                    {
                        if (TempData[key] is string msg)
                        {
                            <div class="alert alert-@css alert-dismissible fade show">@msg<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button></div>
                        }
                    }

                    <div class="row">
                        @foreach (var (color, icon, title, value, note) in boxes)
                        {
                            <div class="col-12 col-sm-6 col-lg-3">
                                <div class="info-box">
                                    <span class="info-box-icon text-bg-@color shadow-sm"><i class="bi bi-@icon"></i></span>
                                    <div class="info-box-content"><span class="info-box-text">@title</span><span class="info-box-number">@value</span><small class="text-secondary">@note</small></div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="row" id="kurum">
                        <div class="col-lg-4">
                            <div class="card card-primary card-outline mb-4">
                                <div class="card-header"><h5 class="card-title"><i class="bi bi-bank2 me-1"></i>Kurum havuz bütçesi</h5></div>
                                <div class="card-body">
                                    <div class="text-secondary small">Kalan havuz (yıllık)</div>
                                    <div class="fs-3 fw-semibold @(Model.PoolRemaining < 0 ? "text-danger" : "")">@Money(Model.PoolRemaining)</div>
                                    <div class="progress progress-sm my-2"><div class="progress-bar bg-@Bar(Model.PoolUsedPercent)" style="width:@(Math.Min(Model.PoolUsedPercent, 100))%"></div></div>
                                    <div class="small text-secondary">@Money(Model.PoolUsed) kullanıldı / @Money(Model.PoolAmount) (%@Model.PoolUsedPercent)</div>
                                    <form asp-action="SetPool" method="post" class="input-group input-group-sm mt-3">
                                        <input type="hidden" name="month" value="@month" />
                                        <input type="number" name="poolAmount" min="0" step="0.01" value="@Num(Model.PoolAmount)" class="form-control" aria-label="Yıllık havuz bütçesi" />
                                        <button class="btn btn-outline-primary">Havuzu kaydet</button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card card-warning card-outline mb-4">
                                <div class="card-header"><h5 class="card-title"><i class="bi bi-calendar2-check me-1"></i>Aylık sabit gider</h5></div>
                                <div class="card-body">
                                    <div class="text-secondary small">Aylık toplam</div>
                                    <div class="fs-3 fw-semibold">@Money(Model.FixedTotal)</div>
                                    <div class="small text-secondary mt-2">@Model.FixedExpenses.Count kalem@(Model.FixedIncomePercent is decimal share ? " · gelirin %" + share.ToString("0", tr) + "'i" : "")</div>
                                    <button form="postForm" formaction="@Url.Action("PostFixedExpenses", new { month })" class="btn btn-sm btn-outline-warning mt-3">Bu ayı işle</button>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card card-danger card-outline mb-4">
                                <div class="card-header"><h5 class="card-title"><i class="bi bi-credit-card-2-front me-1"></i>Kurumun güncel borcu</h5></div>
                                <div class="card-body">
                                    <div class="text-secondary small">Kalan toplam borç</div>
                                    <div class="fs-3 fw-semibold text-@(Model.DebtRemaining > 0 ? "danger" : "success")">@Money(Model.DebtRemaining)</div>
                                    <div class="progress progress-sm my-2"><div class="progress-bar bg-success" style="width:@(Model.DebtPaidPercent)%"></div></div>
                                    <div class="small text-secondary">@Model.OpenDebtCount açık borç · %@Model.DebtPaidPercent ödendi</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-8"><div class="card mb-4"><div class="card-header"><h5 class="card-title">Son 12 ay: gelir, gider ve net</h5></div><div class="card-body"><div id="trendChart"></div></div></div></div>
                        <div class="col-lg-4"><div class="card mb-4"><div class="card-header"><h5 class="card-title">Gider dağılımı</h5></div><div class="card-body"><div id="catChart"></div></div></div></div>
                    </div>

                    <div class="row" id="yonetim">
                        <div class="col-lg-6">
                            <div class="card mb-4">
                                <div class="card-header"><h5 class="card-title">Aylık sabit giderler</h5></div>
                                <div class="card-body p-0 table-responsive">
                                    <table class="table align-middle mb-0">
                                        <tbody>
                                            @foreach (var f in Model.FixedExpenses)
                                            {
                                                <tr>
                                                    <td>@f.CategoryName<div class="small text-secondary">her ayın @f.DayOfMonth. günü</div></td>
                                                    <td class="text-end">@Money(f.Amount)</td>
                                                    <td><span class="badge text-bg-@(f.IsPosted ? "success" : "secondary")">@(f.IsPosted ? "İşlendi" : "Bekliyor")</span></td>
                                                    <td class="text-end"><button form="postForm" formaction="@Url.Action("DeleteFixedExpense", new { id = f.Id, month })" onclick="return confirm('Sabit gider silinsin mi?')" class="btn btn-sm btn-outline-secondary" aria-label="Sil"><i class="bi bi-trash"></i></button></td>
                                                </tr>
                                            }
                                            @if (!Model.FixedExpenses.Any())
                                            {
                                                <tr><td class="text-center text-secondary py-3">Sabit gider tanımlı değil.</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <form asp-action="AddFixedExpense" method="post" class="row g-2 p-3 border-top">
                                    <input type="hidden" name="month" value="@month" />
                                    <div class="col-6 col-md-3"><input name="amount" type="number" min="0.01" step="0.01" class="form-control form-control-sm" placeholder="Tutar" required /></div>
                                    <div class="col-12 col-md-5">
                                        <select name="categoryId" class="form-select form-select-sm" aria-label="Kategori">
                                            @foreach (var c in Model.Categories.Where(x => !x.IsIncome && x.Name != "Borç ödemesi"))
                                            {
                                                <option value="@c.Id">@c.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-6 col-md-4"><input name="dayOfMonth" type="number" min="1" max="31" class="form-control form-control-sm" placeholder="Ayın günü" required /></div>
                                    <div class="col-12 text-end"><button class="btn btn-sm btn-warning">Sabit gider ekle</button></div>
                                </form>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="card mb-4">
                                <div class="card-header"><h5 class="card-title">Kurum borçları</h5></div>
                                <div class="card-body p-0 table-responsive">
                                    <table class="table align-middle mb-0">
                                        <tbody>
                                            @foreach (var d in Model.Debts)
                                            {
                                                <tr>
                                                    <td>@d.Creditor<div class="small text-secondary">@(d.DueDate is DateTime due ? "Vade: " + due.ToString("d", tr) : "Vade yok")</div></td>
                                                    <td class="text-end"><strong class="text-@(d.RemainingAmount > 0 ? "danger" : "success")">@Money(d.RemainingAmount)</strong><div class="small text-secondary">/ @Money(d.TotalAmount)</div></td>
                                                    <td style="min-width:160px">
                                                        @if (d.RemainingAmount > 0)
                                                        {
                                                            <form asp-action="PayDebt" method="post" class="input-group input-group-sm">
                                                                <input type="hidden" name="debtId" value="@d.Id" />
                                                                <input type="number" name="amount" min="0.01" max="@Num(d.RemainingAmount)" step="0.01" value="@Num(d.RemainingAmount)" class="form-control" aria-label="Ödeme tutarı" />
                                                                <button class="btn btn-outline-success">Öde</button>
                                                            </form>
                                                        }
                                                    </td>
                                                    <td class="text-end"><button form="postForm" formaction="@Url.Action("DeleteDebt", new { id = d.Id, month })" onclick="return confirm('Borç kaydı silinsin mi?')" class="btn btn-sm btn-outline-secondary" aria-label="Sil"><i class="bi bi-trash"></i></button></td>
                                                </tr>
                                            }
                                            @if (!Model.Debts.Any())
                                            {
                                                <tr><td class="text-center text-secondary py-3">Kayıtlı borç yok.</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <form asp-action="AddDebt" method="post" class="row g-2 p-3 border-top">
                                    <input type="hidden" name="month" value="@month" />
                                    <div class="col-12 col-md-5"><input name="creditor" class="form-control form-control-sm" placeholder="Alacaklı" maxlength="40" required /></div>
                                    <div class="col-6 col-md-3"><input name="totalAmount" type="number" min="0.01" step="0.01" class="form-control form-control-sm" placeholder="Borç tutarı" required /></div>
                                    <div class="col-6 col-md-4"><input name="dueDate" type="date" class="form-control form-control-sm" aria-label="Vade" /></div>
                                    <div class="col-12 text-end"><button class="btn btn-sm btn-danger">Borç ekle</button></div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-4">
                            <div class="card mb-4">
                                <div class="card-header"><h5 class="card-title">Aylık ortalamalar</h5></div>
                                <div class="card-body">
                                    <p class="text-secondary small">Son 12 ayda işlem yapılan aylar üzerinden hesaplandı.</p>
                                    <div class="d-flex justify-content-between mb-2"><span>Ortalama gelir</span><strong class="text-success">@Money(Model.AvgIncome)</strong></div>
                                    <div class="d-flex justify-content-between mb-2"><span>Ortalama gider</span><strong class="text-danger">@Money(Model.AvgExpense)</strong></div>
                                    <div class="d-flex justify-content-between"><span>Ortalama kalan</span><strong class="text-@(Model.AvgNet < 0 ? "danger" : "primary")">@Money(Model.AvgNet)</strong></div>
                                    <hr />
                                    <p class="text-center"><strong>En çok harcanan kategoriler</strong></p>
                                    @foreach (var c in Model.ExpenseByCategory.Take(5))
                                    {
                                        <div class="progress-group">
                                            @c.Name<span class="float-end"><b>@Money(c.Total)</b> (%@c.Percent)</span>
                                            <div class="progress progress-sm"><div class="progress-bar text-bg-danger" style="width:@(c.Percent)%"></div></div>
                                        </div>
                                    }
                                    @if (!Model.ExpenseByCategory.Any())
                                    {
                                        <p class="text-secondary text-center">Bu ay henüz gider yok.</p>
                                    }
                                    @if (Model.BiggestExpense is { } big)
                                    {
                                        <div class="small text-secondary mt-3">En büyük gider: @Money(big.Amount) (@big.CategoryName@(string.IsNullOrEmpty(big.Note) ? "" : ", " + big.Note))</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-8" id="islemler">
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h5 class="card-title">İşlemler</h5>
                                    <div class="card-tools btn-group btn-group-sm">
                                        @foreach (var (value, label) in new[] { ("hepsi", "Tümü"), ("gelir", "Gelir"), ("gider", "Gider") })
                                        {
                                            <a asp-action="Index" asp-route-month="@month" asp-route-filter="@value" asp-fragment="islemler" class="btn btn-outline-secondary @(Model.Filter == value ? "active" : "")">@label</a>
                                        }
                                    </div>
                                </div>
                                <div class="card-body p-0 table-responsive">
                                    <table class="table table-striped align-middle mb-0">
                                        <thead><tr><th>Tarih</th><th>Tür</th><th>Kategori</th><th>Açıklama</th><th class="text-end">Tutar</th><th></th></tr></thead>
                                        <tbody>
                                            @foreach (var t in Model.Transactions)
                                            {
                                                <tr>
                                                    <td>@t.Date.ToString("d", tr)</td>
                                                    <td><span class="badge text-bg-@(t.IsIncome ? "success" : "danger")">@(t.IsIncome ? "Gelir" : "Gider")</span></td>
                                                    <td>@t.CategoryName</td>
                                                    <td>@t.Note</td>
                                                    <td class="text-end fw-semibold text-@(t.IsIncome ? "success" : "danger")">@(t.IsIncome ? "+" : "-")@Money(t.Amount)</td>
                                                    <td class="text-end"><button form="postForm" formaction="@Url.Action("DeleteTransaction", new { id = t.Id, month, filter = Model.Filter })" onclick="return confirm('Bu kayıt silinsin mi?')" class="btn btn-sm btn-outline-secondary" aria-label="Sil"><i class="bi bi-trash"></i></button></td>
                                                </tr>
                                            }
                                            @if (!Model.Transactions.Any())
                                            {
                                                <tr><td colspan="6" class="text-center text-secondary py-4">Bu ay için kayıt yok. Sağ üstteki "Gelir" veya "Gider" ile ilk kaydı ekleyin.</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </main>

        <footer class="app-footer"><strong>Muhasebe</strong> &copy; @DateTime.Now.Year</footer>
    </div>

    <!-- Yeni işlem: tür, seçilen kategoriden anlaşılır -->
    <div class="modal fade" id="txModal" tabindex="-1" aria-label="Yeni işlem" aria-hidden="true">
        <div class="modal-dialog">
            <form asp-action="AddTransaction" method="post" class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Yeni işlem</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
                <div class="modal-body">
                    <div class="mb-3"><label for="fAmount" class="form-label">Tutar (₺)</label><input type="number" id="fAmount" name="amount" class="form-control" min="0.01" step="0.01" required /></div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label for="fCat" class="form-label">Kategori</label>
                            <select id="fCat" name="categoryId" class="form-select">
                                @foreach (var g in Model.Categories.GroupBy(x => x.IsIncome))
                                {
                                    <optgroup label="@(g.Key ? "Gelir" : "Gider")" data-income="@(g.Key ? "true" : "false")">
                                        @foreach (var c in g)
                                        {
                                            <option value="@c.Id">@c.Name</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>
                        <div class="col-6 mb-3"><label for="fDate" class="form-label">Tarih</label><input type="date" id="fDate" name="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
                    </div>
                    <label for="fNote" class="form-label">Açıklama (isteğe bağlı)</label><input type="text" id="fNote" name="note" class="form-control" maxlength="80" />
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button><button type="submit" class="btn btn-primary">Kaydet</button></div>
            </form>
        </div>
    </div>

    <form asp-action="Index" method="post" id="postForm"></form>   <!-- Silme ve işleme butonlarının ortak formu (anti-forgery token burada) -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4/dist/js/adminlte.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.37.1/dist/apexcharts.min.js"></script>
    <script>
        const trend = @Json.Serialize(Model.Trend);
        const cats = @Json.Serialize(Model.ExpenseByCategory);
        const fmt = (n) => new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY', maximumFractionDigits: 0 }).format(n);

        Apex.theme = { mode: document.documentElement.dataset.bsTheme };
        Apex.chart = { background: 'transparent' };

        new ApexCharts(document.querySelector('#trendChart'), {
            chart: { id: 'trend', type: 'line', height: 320, toolbar: { show: false } },
            series: [
                { name: 'Gelir', type: 'column', data: trend.map(x => x.income) },
                { name: 'Gider', type: 'column', data: trend.map(x => x.expense) },
                { name: 'Net', type: 'line', data: trend.map(x => x.net) }
            ],
            colors: ['#198754', '#dc3545', '#0d6efd'],
            stroke: { width: [0, 0, 3], curve: 'smooth' },
            dataLabels: { enabled: false },
            xaxis: { categories: trend.map(x => x.label) },
            yaxis: { labels: { formatter: v => Math.round(v / 1000) + 'B' } },
            tooltip: { y: { formatter: fmt } }
        }).render();

        new ApexCharts(document.querySelector('#catChart'), {
            chart: { id: 'cat', type: 'donut', height: 320 },
            series: cats.map(x => x.total),
            labels: cats.map(x => x.name),
            dataLabels: { enabled: false },
            legend: { position: 'bottom' },
            tooltip: { y: { formatter: fmt } },
            noData: { text: 'Bu ay gider yok' }
        }).render();

        // "Gelir" / "Gider" butonları kategori listesinde ilgili grubun ilk kategorisini seçer
        document.querySelectorAll('[data-income]').forEach(b => b.addEventListener('click', () => {
            document.querySelector('#fCat').value = document.querySelector(`#fCat optgroup[data-income=${b.dataset.income}] option`).value;
        }));
    </script>
</body>
</html>
